{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": [
				"TURSO_DB_URL",
				"TURSO_SECRET",
				"DATABASE_URL",
				"BETTER_AUTH_URL",
				"BETTER_AUTH_SECRET"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"zip": {
			"dependsOn": ["^build"],
			"outputs": [".output/**"]
		}
	}
}
