{
	"manifest_version": 3,
	"name": "Canvas Grab",
	"version": "1.0.0",
	"description": "Captura imágenes de cualquier página y envíalas a tus lienzos.",
	"permissions": ["storage", "activeTab", "scripting", "notifications"],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"scripts": ["background/service-worker.js"]
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
