---
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Separator } from "@/components/starwind/separator";
import Icons from "./Icons.astro";
---

<div id="category-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
	<div
		class="w-full max-w-lg mx-4 sm:mx-auto rounded-xl border border-border bg-background p-4 sm:p-6 shadow-lg"
		role="dialog"
		aria-labelledby="category-modal-title"
	>
		<!-- Header -->
		<div class="mb-6 flex items-center justify-between">
			<h2 id="category-modal-title" class="text-lg font-semibold">Gestionar categorías</h2>
			<button
				id="btn-close-category-modal"
				class="flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M18 6L6 18M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<!-- Create new category -->
		<div class="mb-6 rounded-lg border border-border bg-muted/30 p-4">
			<h3 class="mb-3 text-sm font-medium">Crear nueva categoría</h3>
			<div class="flex gap-3">
				<div class="flex-1">
					<Input id="new-category-name" placeholder="Nombre de la categoría" class="h-9" />
				</div>
				<div class="flex items-center gap-2">
					<input
						type="color"
						id="new-category-color"
						value="#6b7280"
						class="size-9 cursor-pointer rounded-lg border border-border bg-transparent p-0.5"
					/>
					<Button id="btn-create-category" size="sm" class="gap-1.5">
						<Icons name="plus" class="h-3.5 w-3.5" />
						Crear
					</Button>
				</div>
			</div>
		</div>

		<Separator class="mb-4" />

		<!-- Category list -->
		<div>
			<h3 class="mb-3 text-sm font-medium text-muted-foreground">Categorías existentes</h3>
			<div id="category-list" class="max-h-64 space-y-2 overflow-y-auto">
				<div class="py-4 text-center text-sm text-muted-foreground">Cargando categorías...</div>
			</div>
		</div>
	</div>
</div>

<script>
	interface Category {
		id: string;
		name: string;
		color: string;
		userId: string;
		createdAt: string;
		updatedAt: string;
	}

	const modal = document.getElementById("category-modal")!;
	const categoryList = document.getElementById("category-list")!;
	const nameInput = document.getElementById("new-category-name") as HTMLInputElement;
	const colorInput = document.getElementById("new-category-color") as HTMLInputElement;
	const createBtn = document.getElementById("btn-create-category")!;
	const closeBtn = document.getElementById("btn-close-category-modal")!;

	function escapeHtml(str: string) {
		const div = document.createElement("div");
		div.textContent = str;
		return div.innerHTML;
	}

	function renderCategories(categories: Category[]) {
		if (categories.length === 0) {
			categoryList.innerHTML =
				'<div class="py-4 text-center text-sm text-muted-foreground">No hay categorías creadas.</div>';
			return;
		}

		categoryList.innerHTML = "";
		categories.forEach((cat) => {
			const item = document.createElement("div");
			item.className =
				"flex items-center justify-between rounded-lg border border-border p-3 transition-all hover:border-ring";
			item.innerHTML = `
				<div class="flex items-center gap-3">
					<span class="size-3 rounded-full" style="background-color: ${cat.color}"></span>
					<span class="text-sm font-medium">${escapeHtml(cat.name)}</span>
				</div>
				<div class="flex items-center gap-1">
					<button
						data-edit-id="${cat.id}"
						data-edit-name="${escapeHtml(cat.name)}"
						data-edit-color="${cat.color}"
						class="edit-category-btn flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
						title="Editar"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
						</svg>
					</button>
					<button
						data-delete-id="${cat.id}"
						data-delete-name="${escapeHtml(cat.name)}"
						class="delete-category-btn flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive"
						title="Eliminar"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/>
						</svg>
					</button>
				</div>
			`;
			categoryList.appendChild(item);
		});

		// Attach handlers
		categoryList.querySelectorAll<HTMLButtonElement>(".edit-category-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				nameInput.value = btn.dataset.editName || "";
				colorInput.value = btn.dataset.editColor || "#6b7280";
				createBtn.dataset.editId = btn.dataset.editId || "";
				createBtn.innerHTML = `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Guardar`;
			});
		});

		categoryList.querySelectorAll<HTMLButtonElement>(".delete-category-btn").forEach((btn) => {
			btn.addEventListener("click", async () => {
				if (!confirm(`¿Eliminar la categoría "${btn.dataset.deleteName}"?`)) return;
				try {
					const res = await fetch(`/api/categories/${btn.dataset.deleteId}`, {
						method: "DELETE",
						credentials: "include",
					});
					if (res.ok) {
						await loadCategoryList();
						(window as any).loadCategories?.();
						(window as any).loadCanvases?.();
					}
				} catch {}
			});
		});
	}

	async function loadCategoryList() {
		try {
			const res = await fetch("/api/categories", { credentials: "include" });
			if (res.ok) {
				const categories = await res.json();
				renderCategories(categories);
			}
		} catch {
			categoryList.innerHTML =
				'<div class="py-4 text-center text-sm text-destructive">Error al cargar categorías</div>';
		}
	}

	async function handleCreateOrUpdate() {
		const name = nameInput.value.trim();
		const color = colorInput.value;
		const editId = createBtn.dataset.editId;

		if (!name) {
			nameInput.focus();
			return;
		}

		createBtn.disabled = true;
		try {
			if (editId) {
				await fetch(`/api/categories/${editId}`, {
					method: "PUT",
					headers: { "Content-Type": "application/json" },
					credentials: "include",
					body: JSON.stringify({ name, color }),
				});
				createBtn.dataset.editId = "";
				createBtn.innerHTML = `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Crear`;
			} else {
				await fetch("/api/categories", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "include",
					body: JSON.stringify({ name, color }),
				});
			}
			nameInput.value = "";
			colorInput.value = "#6b7280";
			await loadCategoryList();
			(window as any).loadCategories?.();
		} catch {
			// silently fail
		} finally {
			createBtn.disabled = false;
		}
	}

	createBtn.addEventListener("click", handleCreateOrUpdate);
	nameInput.addEventListener("keydown", (e) => {
		if (e.key === "Enter") handleCreateOrUpdate();
	});

	function openModal() {
		modal.classList.remove("hidden");
		modal.classList.add("flex");
		loadCategoryList();
	}

	function closeModal() {
		modal.classList.add("hidden");
		modal.classList.remove("flex");
		createBtn.dataset.editId = "";
		createBtn.innerHTML = `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Crear`;
		nameInput.value = "";
		colorInput.value = "#6b7280";
	}

	closeBtn.addEventListener("click", closeModal);
	modal.addEventListener("click", (e) => {
		if (e.target === modal) closeModal();
	});

	// Expose for external use
	(window as any).openCategoryModal = openModal;
	(window as any).closeCategoryModal = closeModal;
</script>
