---
import { Button } from "@/components/starwind/button/Button.astro";
import { Separator } from "@/components/starwind/separator/Separator.astro";
import Icons from "./Icons.astro";
---

<header class="sticky top-0 z-10 border-b border-border bg-background/80 backdrop-blur-sm">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
		<div class="flex items-center gap-3">
			<a href="/" class="flex items-center gap-3 group">
				<div
					class="flex h-9 w-9 items-center justify-center rounded-lg bg-foreground text-background transition-transform group-hover:scale-105"
				>
					<Icons name="canvas" class="h-4 w-4" />
				</div>
				<span class="text-lg font-semibold tracking-tight">Canvas</span>
			</a>
		</div>
		<div class="flex items-center gap-4">
			<div class="flex items-center gap-2">
				<div
					class="flex h-8 w-8 items-center justify-center rounded-full bg-muted text-muted-foreground"
				>
					<Icons name="user" class="h-4 w-4" />
				</div>
				<span id="user-name" class="text-sm font-medium text-muted-foreground font-mono"></span>
			</div>
			<Separator orientation="vertical" class="h-6" />
			<Button
				id="btn-logout"
				variant="ghost"
				size="sm"
				class="gap-2"
			>
				<Icons name="logout" class="h-4 w-4" />
				<span class="hidden sm:inline">Cerrar sesión</span>
			</Button>
		</div>
	</div>
</header>
