---

---

<div id="canvas-grid" class="hidden"></div>

<!-- Category assign dropdown (shared, positioned absolutely) -->
<div
	id="category-dropdown"
	class="fixed z-50 hidden w-56 rounded-lg border border-border bg-background p-1 shadow-lg"
>
	<div id="category-dropdown-list" class="max-h-48 overflow-y-auto"></div>
</div>

<script>
	interface CanvasItem {
		id: string;
		name: string;
		description: string | null;
		categoryId: string | null;
		thumbnail: string | null;
		createdAt: string;
		updatedAt: string;
		imageCount: number;
	}

	interface Category {
		id: string;
		name: string;
		color: string;
	}

	let allCanvases: CanvasItem[] = [];
	let categories: Category[] = [];
	let activeFilter: string | null = null;

	const grid = document.getElementById("canvas-grid")!;
	const dropdown = document.getElementById("category-dropdown")!;
	const dropdownList = document.getElementById("category-dropdown-list")!;
	const deleteModal = document.getElementById("delete-modal")!;
	const deleteDialog = deleteModal?.querySelector("dialog") as HTMLDialogElement;
	const deleteBackdrop = deleteModal?.querySelector(
		".starwind-alert-dialog-backdrop",
	) as HTMLElement;
	let deleteTargetId: string | null = null;

	// Expose deleteTargetId for external access
	(window as any).getDeleteTargetId = () => deleteTargetId;
	(window as any).clearDeleteTargetId = () => {
		deleteTargetId = null;
	};

	function renderGrid() {
		const filtered =
			activeFilter === "none"
				? allCanvases.filter((c) => !c.categoryId)
				: activeFilter
					? allCanvases.filter((c) => c.categoryId === activeFilter)
					: allCanvases;

		const loadingState = document.getElementById("loading-state")!;
		const emptyState = document.getElementById("empty-state")!;

		loadingState.classList.add("hidden");

		if (filtered.length === 0) {
			grid.classList.add("hidden");
			if (allCanvases.length === 0) {
				emptyState.classList.remove("hidden");
			} else {
				emptyState.classList.add("hidden");
				grid.innerHTML =
					'<div class="py-12 text-center text-sm text-muted-foreground">No hay lienzos en esta categoría.</div>';
				grid.classList.remove("hidden");
			}
			return;
		}

		emptyState.classList.add("hidden");
		grid.innerHTML = "";
		grid.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4";

		filtered.forEach((c) => {
			const cat = c.categoryId ? categories.find((ca) => ca.id === c.categoryId) : null;
			const item = document.createElement("div");
			item.className = "group";
			item.innerHTML = `
				<a href="/canvas/${c.id}" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-5 rounded-xl border border-border p-3 sm:p-4 transition-colors hover:bg-muted/50">
					<div class="flex-shrink-0 h-32 sm:h-20 w-full sm:w-32 overflow-hidden rounded-lg bg-muted">
						${
							c.thumbnail
								? `<img src="${c.thumbnail}" alt="${c.name}" class="h-full w-full object-cover" />`
								: `<div class="flex h-full items-center justify-center">
									<svg class="h-10 w-10 text-muted-foreground/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
										<rect x="3" y="3" width="18" height="18" rx="2"/>
										<circle cx="8.5" cy="8.5" r="1.5"/>
										<polyline points="21 15 16 10 5 21"/>
									</svg>
								</div>`
						}
					</div>
					<div class="flex-1 min-w-0">
						<div class="flex items-start justify-between gap-2">
							<h3 class="text-base sm:text-lg font-semibold text-foreground truncate group-hover:text-primary transition-colors">${escapeHtml(c.name)}</h3>
							<button
								data-delete-id="${c.id}"
								data-delete-name="${escapeHtml(c.name)}"
								class="delete-btn flex-shrink-0 flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive sm:opacity-0 sm:group-hover:opacity-100"
								title="Eliminar"
							>
								<svg class="h-4 w-4 sm:h-4.5 sm:w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/>
								</svg>
							</button>
						</div>
						${c.description ? `<p class="mt-1 text-sm text-muted-foreground truncate">${escapeHtml(c.description)}</p>` : ""}
						<div class="flex flex-wrap items-center gap-2 mt-2">
							${
								cat
									? `<button
										type="button"
										data-assign-canvas-id="${c.id}"
										class="category-badge inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium transition-colors hover:opacity-80"
										style="background-color: ${cat.color}15; color: ${cat.color}; border: 1px solid ${cat.color}40"
									>
										<span class="size-1.5 rounded-full" style="background-color: ${cat.color}"></span>
										${escapeHtml(cat.name)}
									</button>`
									: `<button
										type="button"
										data-assign-canvas-id="${c.id}"
										class="category-badge inline-flex items-center gap-1.5 rounded-full border border-dashed border-border px-2 py-0.5 text-xs font-medium text-muted-foreground transition-colors hover:border-muted-foreground/50 hover:text-foreground"
									>
										Asignar categoría
									</button>`
							}
							${
								c.imageCount > 0
									? `<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
								<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
									<circle cx="8.5" cy="8.5" r="1.5"/>
									<polyline points="21 15 16 10 5 21"/>
								</svg>
								${c.imageCount} ${c.imageCount === 1 ? "imagen" : "imágenes"}
							</div>`
									: ""
							}
						</div>
						<div class="mt-2 flex flex-wrap items-center gap-2 sm:gap-3 text-[11px] sm:text-xs text-muted-foreground/70">
							<span class="flex items-center gap-1" title="Creado">
								<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"/>
									<polyline points="12 6 12 12 16 14"/>
								</svg>
								Creado: ${formatDate(c.createdAt)}
							</span>
							<span class="flex items-center gap-1" title="Modificado">
								<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
								</svg>
								Modificado: ${formatDate(c.updatedAt)}
							</span>
						</div>
					</div>
				</a>
			`;
			grid.appendChild(item);
		});

		// Attach delete handlers
		grid.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
			btn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				deleteTargetId = btn.dataset.deleteId!;
				const deleteCanvasNameEl = document.getElementById("delete-canvas-name");
				if (deleteCanvasNameEl) deleteCanvasNameEl.textContent = btn.dataset.deleteName || "";
				deleteBackdrop?.classList.remove("hidden");
				deleteBackdrop?.setAttribute("data-state", "open");
				deleteDialog?.setAttribute("data-state", "open");
				deleteDialog?.showModal();
			});
		});

		// Attach category assign handlers
		grid.querySelectorAll<HTMLButtonElement>("[data-assign-canvas-id]").forEach((btn) => {
			btn.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				showCategoryDropdown(btn, btn.dataset.assignCanvasId!);
			});
		});

		grid.classList.remove("hidden");
	}

	function showCategoryDropdown(anchor: HTMLElement, canvasId: string) {
		const rect = anchor.getBoundingClientRect();
		dropdown.style.top = `${rect.bottom + 4}px`;
		dropdown.style.left = `${rect.left}px`;
		dropdown.classList.remove("hidden");

		dropdownList.innerHTML = "";

		// Option: remove category
		if (allCanvases.find((c) => c.id === canvasId)?.categoryId) {
			const removeBtn = document.createElement("button");
			removeBtn.className =
				"flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted";
			removeBtn.innerHTML = `
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
				Sin categoría
			`;
			removeBtn.addEventListener("click", () => assignCategory(canvasId, null));
			dropdownList.appendChild(removeBtn);
		}

		// Category options
		categories.forEach((cat) => {
			const btn = document.createElement("button");
			btn.className =
				"flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm transition-colors hover:bg-muted";
			btn.innerHTML = `
				<span class="size-2.5 rounded-full" style="background-color: ${cat.color}"></span>
				${escapeHtml(cat.name)}
			`;
			btn.addEventListener("click", () => assignCategory(canvasId, cat.id));
			dropdownList.appendChild(btn);
		});

		if (categories.length === 0) {
			dropdownList.innerHTML =
				'<div class="px-3 py-2 text-sm text-muted-foreground">No hay categorías creadas.</div>';
		}
	}

	async function assignCategory(canvasId: string, categoryId: string | null) {
		dropdown.classList.add("hidden");
		try {
			const res = await fetch(`/api/canvases/${canvasId}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				credentials: "include",
				body: JSON.stringify({ categoryId }),
			});
			if (res.ok) {
				// Update local data
				const canvas = allCanvases.find((c) => c.id === canvasId);
				if (canvas) canvas.categoryId = categoryId;
				renderGrid();
			}
		} catch {}
	}

	// Close dropdown on outside click
	document.addEventListener("click", (e) => {
		if (!dropdown.contains(e.target as Node)) {
			dropdown.classList.add("hidden");
		}
	});

	// Listen for filter changes
	window.addEventListener("category-filter-change", ((e: CustomEvent) => {
		activeFilter = e.detail.categoryId;
		renderGrid();
	}) as EventListener);

	export async function loadCanvases() {
		const loadingState = document.getElementById("loading-state")!;
		const emptyState = document.getElementById("empty-state")!;

		loadingState.classList.remove("hidden");
		grid.classList.add("hidden");
		emptyState.classList.add("hidden");

		try {
			const canvasesRes = await fetch("/api/canvases", { credentials: "include" });

			if (!canvasesRes.ok) throw new Error("Failed to load");
			allCanvases = await canvasesRes.json();

			// Use categories already loaded by CategoryFilter (single source of truth)
			categories = (window as any).__categories || [];

			loadingState.classList.add("hidden");
			renderGrid();
		} catch {
			loadingState.innerHTML =
				'<div class="text-sm text-destructive">Error al cargar lienzos</div>';
		}
	}

	function escapeHtml(str: string) {
		const div = document.createElement("div");
		div.textContent = str;
		return div.innerHTML;
	}

	function formatDate(dateStr: string) {
		const d = new Date(dateStr);
		return d.toLocaleDateString("es-ES", {
			day: "numeric",
			month: "short",
			year: "numeric",
		});
	}

	// Expose for external use
	(window as any).loadCanvases = loadCanvases;
</script>
