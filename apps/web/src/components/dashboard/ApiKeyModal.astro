---
import Icons from "./Icons.astro";
---

<div
	id="api-keys-modal"
	class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
>
	<div
		class="mx-4 w-full max-w-lg rounded-xl border border-border bg-background shadow-xl"
		role="dialog"
		aria-modal="true"
		aria-labelledby="api-keys-modal-title"
	>
		<!-- Header -->
		<div class="flex items-center justify-between border-b border-border px-5 py-4">
			<div class="flex items-center gap-3">
				<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-muted">
					<Icons name="key" class="h-4 w-4 text-muted-foreground" />
				</div>
				<h3 id="api-keys-modal-title" class="text-base font-semibold">API Keys</h3>
			</div>
			<button
				id="btn-close-api-modal"
				class="rounded-lg p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
			>
				<Icons name="close" class="h-4 w-4" />
			</button>
		</div>

		<div class="p-5">
			<!-- New API Key Display (hidden by default) -->
			<div
				id="new-api-key-display"
				class="hidden mb-5 rounded-lg border border-green-500/30 bg-green-500/5 p-4"
			>
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center gap-2">
						<Icons name="check" class="h-4 w-4 text-green-600" />
						<span class="text-sm font-medium text-green-600">Key generada</span>
					</div>
					<button id="btn-close-new-key" class="rounded p-1 text-muted-foreground hover:bg-muted">
						<Icons name="close" class="h-3.5 w-3.5" />
					</button>
				</div>
				<p class="text-xs text-muted-foreground mb-2">Guárdala. No podrás verla de nuevo.</p>
				<div class="flex items-center gap-2">
					<code
						id="new-api-key-value"
						class="flex-1 rounded bg-muted px-3 py-2 text-xs font-mono break-all border border-border"
					></code>
					<button
						id="btn-copy-api-key"
						class="rounded-lg border border-border px-3 py-2 text-xs font-medium hover:bg-muted"
					>
						<Icons name="copy" class="h-3.5 w-3.5" />
					</button>
				</div>
			</div>

			<!-- Create Form -->
			<div class="space-y-4">
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label for="api-key-name" class="block text-xs font-medium text-muted-foreground mb-1"
							>Nombre</label
						>
						<input
							type="text"
							id="api-key-name"
							placeholder="Mi API Key"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring"
						/>
					</div>
					<div>
						<label for="api-key-expiry" class="block text-xs font-medium text-muted-foreground mb-1"
							>Expiración</label
						>
						<select
							id="api-key-expiry"
							class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-ring"
						>
							<option value="">Sin expiración</option>
							<option value="3600">1 hora</option>
							<option value="86400">1 día</option>
							<option value="604800">7 días</option>
							<option value="2592000">30 días</option>
							<option value="7776000">90 días</option>
							<option value="31536000">1 año</option>
						</select>
					</div>
				</div>

				<!-- Permissions (compact) -->
				<div>
					<label class="block text-xs font-medium text-muted-foreground mb-2">Permisos</label>
					<div class="flex flex-wrap gap-2">
						<label
							class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs transition-colors hover:bg-muted cursor-pointer"
						>
							<input
								type="checkbox"
								id="perm-canvas-read"
								checked
								class="rounded border-border h-3.5 w-3.5"
							/>
							<span class="font-mono">canvas:read</span>
						</label>
						<label
							class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs transition-colors hover:bg-muted cursor-pointer"
						>
							<input
								type="checkbox"
								id="perm-canvas-write"
								checked
								class="rounded border-border h-3.5 w-3.5"
							/>
							<span class="font-mono">canvas:write</span>
						</label>
						<label
							class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs transition-colors hover:bg-muted cursor-pointer"
						>
							<input
								type="checkbox"
								id="perm-images-read"
								checked
								class="rounded border-border h-3.5 w-3.5"
							/>
							<span class="font-mono">images:read</span>
						</label>
						<label
							class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs transition-colors hover:bg-muted cursor-pointer"
						>
							<input
								type="checkbox"
								id="perm-images-write"
								checked
								class="rounded border-border h-3.5 w-3.5"
							/>
							<span class="font-mono">images:write</span>
						</label>
					</div>
				</div>

				<!-- Advanced toggle -->
				<details class="group">
					<summary
						class="flex items-center gap-2 text-xs font-medium text-muted-foreground cursor-pointer select-none hover:text-foreground transition-colors"
					>
						<Icons name="settings" class="h-3.5 w-3.5" />
						Avanzado
						<svg
							class="h-3 w-3 transition-transform group-open:rotate-90"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg
						>
					</summary>
					<div class="mt-3 space-y-3 pl-5.5">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label for="api-key-prefix" class="block text-xs text-muted-foreground mb-1"
									>Prefijo</label
								>
								<input
									type="text"
									id="api-key-prefix"
									placeholder="rldn_"
									class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-ring"
								/>
							</div>
							<div>
								<label for="api-key-metadata" class="block text-xs text-muted-foreground mb-1"
									>Metadata</label
								>
								<input
									type="text"
									id="api-key-metadata"
									placeholder='{"plan":"free"}'
									class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-ring"
								/>
							</div>
						</div>
						<div class="grid grid-cols-2 gap-3">
							<div class="flex items-center gap-2">
								<input
									type="checkbox"
									id="api-key-rate-limit-enabled"
									class="rounded border-border h-3.5 w-3.5"
								/>
								<label for="api-key-rate-limit-enabled" class="text-xs">Rate limit</label>
							</div>
							<div></div>
							<div>
								<label for="api-key-rate-limit-max" class="block text-xs text-muted-foreground mb-1"
									>Max reqs</label
								>
								<input
									type="number"
									id="api-key-rate-limit-max"
									placeholder="100"
									class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-ring"
								/>
							</div>
							<div>
								<label for="api-key-remaining" class="block text-xs text-muted-foreground mb-1"
									>Restantes</label
								>
								<input
									type="number"
									id="api-key-remaining"
									placeholder="Sin límite"
									class="w-full rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-ring"
								/>
							</div>
						</div>
					</div>
				</details>

				<!-- Actions -->
				<div class="flex justify-end gap-3 pt-2">
					<button
						id="btn-create-api-key"
						class="flex items-center gap-2 rounded-lg bg-foreground px-4 py-2 text-sm font-medium text-background transition-all hover:scale-105 hover:shadow-lg"
					>
						<Icons name="plus" class="h-4 w-4" />
						Generar
					</button>
				</div>
			</div>

			<!-- Existing API Keys -->
			<div class="mt-5 pt-5 border-t border-border">
				<h4 class="text-xs font-medium text-muted-foreground mb-3">Keys existentes</h4>
				<div id="api-keys-list" class="space-y-2">
					<div
						class="text-xs text-muted-foreground py-6 text-center rounded-lg border border-dashed border-border"
					>
						No hay API keys creadas.
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Delete Confirmation Modal -->
<div
	id="api-key-delete-modal"
	class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm"
>
	<div
		class="mx-4 w-full max-w-sm rounded-xl border border-border bg-background p-5 shadow-xl"
		role="alertdialog"
		aria-modal="true"
	>
		<div class="flex items-center gap-3 mb-3">
			<div
				class="flex h-9 w-9 items-center justify-center rounded-full bg-destructive/10 text-destructive"
			>
				<Icons name="alert" class="h-4 w-4" />
			</div>
			<div>
				<h4 class="text-sm font-semibold">Eliminar API Key</h4>
				<p class="text-xs text-muted-foreground">Esta acción es permanente.</p>
			</div>
		</div>
		<p class="text-sm text-muted-foreground ml-12">
			¿Eliminar <code id="delete-key-name" class="font-mono text-foreground"></code>? No podrás
			recuperarla.
		</p>
		<div class="flex justify-end gap-3 mt-5">
			<button
				id="btn-cancel-delete-api-key"
				class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted"
			>
				Cancelar
			</button>
			<button
				id="btn-confirm-delete-api-key"
				class="rounded-lg bg-destructive px-4 py-2 text-sm font-medium text-white transition-all hover:scale-105"
			>
				Eliminar
			</button>
		</div>
	</div>
</div>
