---
import Icons from "./Icons.astro";
---

<div
	id="delete-modal"
	class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
>
	<div
		class="mx-4 w-full max-w-sm rounded-xl border border-border bg-background p-6 shadow-xl"
		role="dialog"
		aria-modal="true"
		aria-labelledby="delete-modal-title"
	>
		<div class="flex items-center gap-3 mb-4">
			<div
				class="flex h-10 w-10 items-center justify-center rounded-full bg-destructive/10 text-destructive"
			>
				<Icons name="alert" class="h-5 w-5" />
			</div>
			<h3 id="delete-modal-title" class="text-lg font-semibold">Eliminar lienzo</h3>
		</div>
		<p class="text-sm text-muted-foreground ml-13">
			¿Estás seguro de que deseas eliminar este lienzo? Esta acción no se puede deshacer.
		</p>
		<div class="mt-6 flex justify-end gap-3">
			<button
				id="btn-cancel-delete"
				class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted"
			>
				Cancelar
			</button>
			<button
				id="btn-confirm-delete"
				class="rounded-lg bg-destructive px-4 py-2 text-sm font-medium text-white transition-all hover:scale-105 hover:shadow-lg"
			>
				Eliminar
			</button>
		</div>
	</div>
</div>
