---
interface Props {
	id: string;
	name: string;
	prefix?: string;
	expiresAt?: string;
	remaining?: number | null;
	enabled?: boolean;
}

const { id, name, prefix = "rldn_", expiresAt, remaining, enabled = true } = Astro.props;
---

<div
	class="rounded-xl border border-border p-4 flex items-center justify-between transition-all hover:border-ring hover:shadow-sm"
	data-key-id={id}
>
	<div class="flex-1 min-w-0">
		<div class="flex items-center gap-2 flex-wrap">
			<span class="font-medium text-sm">{name || "Sin nombre"}</span>
			<span class="text-xs px-2 py-0.5 rounded-full bg-muted font-mono text-muted-foreground"
				>{prefix}****</span
			>
			{
				!enabled && (
					<span class="text-xs px-2 py-0.5 rounded-full bg-destructive/10 text-destructive">
						Deshabilitada
					</span>
				)
			}
		</div>
		<div class="mt-1.5 flex items-center gap-3 text-xs text-muted-foreground">
			{
				expiresAt && (
					<span class="flex items-center gap-1">
						<svg
							class="h-3 w-3"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<circle cx="12" cy="12" r="10" />
							<polyline points="12 6 12 12 16 14" />
						</svg>
						Expira: {new Date(expiresAt).toLocaleDateString("es-ES")}
					</span>
				)
			}
			{
				remaining !== null && remaining !== undefined && (
					<span class="flex items-center gap-1">
						<svg
							class="h-3 w-3"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
						</svg>
						Restantes: {remaining}
					</span>
				)
			}
		</div>
	</div>
	<button
		data-delete-key-id={id}
		class="delete-api-key-btn ml-4 rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-all hover:bg-destructive hover:text-white hover:border-destructive"
	>
		Eliminar
	</button>
</div>
