---
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/features/dashboard/components/TopBar.astro";
import LoadingState from "@/features/dashboard/components/LoadingState.astro";
import EmptyState from "@/features/dashboard/components/EmptyState.astro";
import CanvasGrid from "@/features/dashboard/components/CanvasGrid.astro";
import DeleteModal from "@/features/dashboard/components/DeleteModal.astro";
import ApiKeyModal from "@/features/dashboard/components/ApiKeyModal.astro";
import CategoryFilter from "@/features/dashboard/components/CategoryFilter.astro";
import CategoryModal from "@/features/dashboard/components/CategoryModal.astro";
import Icons from "@/features/dashboard/components/Icons.astro";
import { Button } from "@/components/starwind/button";
import { AlertDialogTrigger } from "@/components/starwind/alert-dialog";
import { Toaster } from "@/components/starwind/toast";
---

<Layout title="Dashboard - Canvas App">
	<div class="min-h-screen bg-background">
		<TopBar />

		<!-- Main Content -->
		<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
			<!-- Header -->
			<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<h1 class="text-2xl font-bold tracking-tight">Mis lienzos</h1>
					<p class="mt-1 text-sm text-muted-foreground">Gestiona y organiza todos tus lienzos</p>
				</div>
				<div class="flex items-center gap-3">
					<AlertDialogTrigger for="api-keys-modal" asChild>
						<Button id="btn-api-keys" variant="outline" class="gap-2">
							<Icons name="key" class="h-4 w-4" />
							<span class="hidden sm:inline">API Keys</span>
						</Button>
					</AlertDialogTrigger>
					<Button id="btn-categories" variant="outline" class="gap-2">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
						</svg>
						<span class="hidden sm:inline">Categorías</span>
					</Button>
					<Button id="btn-new-canvas" class="gap-2">
						<Icons name="plus" class="h-4 w-4" />
						Nuevo lienzo
					</Button>
				</div>
			</div>

			<!-- Category filter -->
			<div class="mb-6">
				<CategoryFilter />
			</div>

			<LoadingState />
			<EmptyState />
			<CanvasGrid />
		</main>
	</div>

	<DeleteModal />
	<ApiKeyModal />
	<CategoryModal />
	<Toaster />

	<script>
		import { authClient } from "@/shared/lib/auth-client";

		// Wait for DOM to be ready
		document.addEventListener("DOMContentLoaded", () => {
			init();
		});

		// Also run immediately in case DOMContentLoaded already fired
		init();

		async function init() {
			try {
				const sessionRes = await fetch("/api/auth/get-session", {
					credentials: "include",
				});
				if (!sessionRes.ok) {
					window.location.href = "/login";
					return;
				}
				const sessionData = await sessionRes.json();

				if (!sessionData?.user) {
					window.location.href = "/login";
					return;
				}

				document.getElementById("user-name")!.textContent =
					sessionData.user.name || sessionData.user.email;

				// Load canvases using the component's function
				await (window as any).loadCanvases();
				// Load category filters
				await (window as any).loadCategories();
			} catch {
				window.location.href = "/login";
			}
		}

		// Create canvas
		async function createCanvas() {
			const btn = document.getElementById("btn-new-canvas")! as HTMLButtonElement;
			const btnEmpty = document.getElementById("btn-new-canvas-empty")! as HTMLButtonElement;
			if (btn) btn.disabled = true;
			if (btnEmpty) btnEmpty.disabled = true;

			try {
				const res = await fetch("/api/canvases", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ name: "Sin título" }),
					credentials: "include",
				});
				if (!res.ok) throw new Error("Failed");
				const canvas = await res.json();
				window.location.href = `/canvas/${canvas.id}`;
			} catch {
				if (btn) btn.disabled = false;
				if (btnEmpty) btnEmpty.disabled = false;
			}
		}

		document.getElementById("btn-new-canvas")?.addEventListener("click", createCanvas);
		document.getElementById("btn-new-canvas-empty")?.addEventListener("click", createCanvas);
		document.getElementById("btn-categories")?.addEventListener("click", () => {
			(window as any).openCategoryModal();
		});

		// Delete canvas
		const canvasDeleteModal = document.getElementById("delete-modal")!;
		const canvasDeleteDialog = canvasDeleteModal?.querySelector("dialog") as HTMLDialogElement;
		const canvasDeleteBackdrop = canvasDeleteModal?.querySelector(
			".starwind-alert-dialog-backdrop",
		) as HTMLElement;

		function closeCanvasDeleteDialog() {
			canvasDeleteBackdrop?.classList.add("hidden");
			canvasDeleteBackdrop?.setAttribute("data-state", "closed");
			canvasDeleteDialog?.setAttribute("data-state", "closed");
			setTimeout(() => {
				canvasDeleteDialog?.close();
			}, 200);
		}

		document.getElementById("btn-cancel-delete")?.addEventListener("click", () => {
			closeCanvasDeleteDialog();
			(window as any).clearDeleteTargetId();
		});

		document.getElementById("btn-confirm-delete")?.addEventListener("click", async () => {
			const deleteTargetId = (window as any).getDeleteTargetId();
			if (!deleteTargetId) return;
			try {
				await fetch(`/api/canvases/${deleteTargetId}`, {
					method: "DELETE",
					credentials: "include",
				});
				closeCanvasDeleteDialog();
				(window as any).clearDeleteTargetId();
				await (window as any).loadCanvases();
			} catch {
				// silently fail
			}
		});

		// Logout
		document.getElementById("btn-logout")?.addEventListener("click", async () => {
			await fetch("/api/auth/sign-out", {
				method: "POST",
				credentials: "include",
			});
			window.location.href = "/";
		});

		// API Keys Management
		const apiKeysModal = document.getElementById("api-keys-modal")!;
		const newApiKeyDisplay = document.getElementById("new-api-key-display")!;
		const newApiKeyValue = document.getElementById("new-api-key-value")!;
		const apiKeysList = document.getElementById("api-keys-list")!;

		// Open API Keys modal
		document.getElementById("btn-api-keys")?.addEventListener("click", async () => {
			apiKeysModal.classList.remove("hidden");
			await loadApiKeys();
		});

		// Close API Keys modal
		document.getElementById("btn-close-api-modal")?.addEventListener("click", () => {
			apiKeysModal.classList.add("hidden");
		});

		// Close on backdrop click
		apiKeysModal?.addEventListener("click", (e) => {
			if (e.target === apiKeysModal) {
				apiKeysModal.classList.add("hidden");
			}
		});

		// Close new key display
		document.getElementById("btn-close-new-key")?.addEventListener("click", () => {
			newApiKeyDisplay.classList.add("hidden");
		});

		// Copy API key to clipboard
		document.getElementById("btn-copy-api-key")?.addEventListener("click", async () => {
			const key = newApiKeyValue.textContent;
			if (key) {
				await navigator.clipboard.writeText(key);
				const btn = document.getElementById("btn-copy-api-key")!;
				btn.textContent = "Copiado!";
				setTimeout(() => {
					btn.innerHTML = `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copiar`;
				}, 2000);
			}
		});

		// Create API Key
		document.getElementById("btn-create-api-key")?.addEventListener("click", async () => {
			const btn = document.getElementById("btn-create-api-key")! as HTMLButtonElement;
			btn.disabled = true;
			btn.innerHTML =
				'<svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="30 60" /></svg> Creando...';

			try {
				const name =
					(document.getElementById("api-key-name") as HTMLInputElement).value || "API Key";
				const expiresIn = (document.getElementById("api-key-expiry") as HTMLSelectElement).value;
				const prefix =
					(document.getElementById("api-key-prefix") as HTMLInputElement).value || undefined;
				const metadataStr = (document.getElementById("api-key-metadata") as HTMLInputElement).value;

				// Parse metadata
				let metadata = null;
				if (metadataStr) {
					try {
						metadata = JSON.parse(metadataStr);
					} catch {
						alert("JSON de metadata inválido");
						return;
					}
				}

				// Build permissions
				const permissions: Record<string, string[]> = {};
				if ((document.getElementById("perm-canvas-read") as HTMLInputElement).checked) {
					permissions.canvas = permissions.canvas || [];
					permissions.canvas.push("read");
				}
				if ((document.getElementById("perm-canvas-write") as HTMLInputElement).checked) {
					permissions.canvas = permissions.canvas || [];
					permissions.canvas.push("write");
				}
				if ((document.getElementById("perm-images-read") as HTMLInputElement).checked) {
					permissions.images = permissions.images || [];
					permissions.images.push("read");
				}
				if ((document.getElementById("perm-images-write") as HTMLInputElement).checked) {
					permissions.images = permissions.images || [];
					permissions.images.push("write");
				}

				// Build create options
				const createOptions: any = {
					name,
					metadata,
					permissions,
				};

				if (expiresIn) {
					createOptions.expiresIn = parseInt(expiresIn);
				}

				if (prefix) {
					createOptions.prefix = prefix;
				}

				// Rate limiting
				const rateLimitEnabled = (
					document.getElementById("api-key-rate-limit-enabled") as HTMLInputElement
				).checked;
				if (rateLimitEnabled) {
					createOptions.rateLimitEnabled = true;
					const max = (document.getElementById("api-key-rate-limit-max") as HTMLInputElement).value;
					if (max) createOptions.rateLimitMax = parseInt(max);
				}

				// Remaining
				const remaining = (document.getElementById("api-key-remaining") as HTMLInputElement).value;
				if (remaining) createOptions.remaining = parseInt(remaining);

				const createRes = await fetch("/api/api-keys/create", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					credentials: "include",
					body: JSON.stringify(createOptions),
				});
				const createData = await createRes.json();

				if (!createRes.ok || createData.error) {
					alert(`Error: ${createData.error || "No se pudo crear la API key"}`);
					return;
				}

				if (createData?.key) {
					newApiKeyValue.textContent = createData.key;
					newApiKeyDisplay.classList.remove("hidden");

					// Reset form
					(document.getElementById("api-key-name") as HTMLInputElement).value = "";
					(document.getElementById("api-key-expiry") as HTMLSelectElement).value = "";
					(document.getElementById("api-key-prefix") as HTMLInputElement).value = "";
					(document.getElementById("api-key-metadata") as HTMLInputElement).value = "";
					(document.getElementById("api-key-rate-limit-enabled") as HTMLInputElement).checked =
						false;
					(document.getElementById("api-key-rate-limit-max") as HTMLInputElement).value = "";
					(document.getElementById("api-key-remaining") as HTMLInputElement).value = "";

					await loadApiKeys();
				}
			} catch (err) {
				alert("Error al crear la API key");
			} finally {
				btn.disabled = false;
				btn.innerHTML = `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> Generar`;
			}
		});

		// Load API Keys
		let deleteKeyId: string | null = null;
		let deleteKeyName: string | null = null;
		const deleteModal = document.getElementById("api-key-delete-modal")!;
		const deleteDialog = deleteModal.querySelector("dialog") as HTMLDialogElement;
		const deleteBackdrop = deleteModal.querySelector(
			".starwind-alert-dialog-backdrop",
		) as HTMLElement;
		const deleteKeyNameEl = document.getElementById("delete-key-name")!;

		document.getElementById("btn-cancel-delete-api-key")?.addEventListener("click", () => {
			deleteBackdrop?.classList.add("hidden");
			deleteBackdrop?.setAttribute("data-state", "closed");
			deleteDialog?.setAttribute("data-state", "closed");
			setTimeout(() => {
				deleteDialog?.close();
			}, 200);
			deleteKeyId = null;
			deleteKeyName = null;
		});

		document.getElementById("btn-confirm-delete-api-key")?.addEventListener("click", async () => {
			if (!deleteKeyId) return;
			try {
				const { error } = await authClient.apiKey.delete({ keyId: deleteKeyId });
				if (error) {
					alert(`Error: ${error.message || "No se pudo eliminar"}`);
					return;
				}
				deleteBackdrop?.classList.add("hidden");
				deleteBackdrop?.setAttribute("data-state", "closed");
				deleteDialog?.setAttribute("data-state", "closed");
				setTimeout(() => {
					deleteDialog?.close();
				}, 200);
				deleteKeyId = null;
				deleteKeyName = null;
				await loadApiKeys();
			} catch {
				alert("Error al eliminar la API key");
			}
		});

		async function loadApiKeys() {
			try {
				const { data, error } = await authClient.apiKey.list({});

				if (error) {
					apiKeysList.innerHTML =
						'<div class="text-xs text-destructive py-4 text-center">Error al cargar API keys</div>';
					return;
				}

				if (!data?.apiKeys || data.apiKeys.length === 0) {
					apiKeysList.innerHTML =
						'<div class="text-xs text-muted-foreground py-6 text-center rounded-lg border border-dashed border-border">No hay API keys creadas.</div>';
					return;
				}

				apiKeysList.innerHTML = "";
				data.apiKeys.forEach((apiKey: any) => {
					const card = document.createElement("div");
					card.className =
						"rounded-lg border border-border p-3 flex items-center justify-between transition-all hover:border-ring";
					card.innerHTML = `
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="text-sm font-medium truncate">${escapeHtml(apiKey.name || "Sin nombre")}</span>
								<code class="text-[10px] px-1.5 py-0.5 rounded bg-muted font-mono text-muted-foreground">${apiKey.prefix || "rldn_"}****</code>
								${apiKey.enabled === false ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-destructive/10 text-destructive">Off</span>' : ""}
							</div>
							<div class="mt-1 text-[11px] text-muted-foreground font-mono">
								${apiKey.expiresAt ? `expira ${new Date(apiKey.expiresAt).toLocaleDateString("es-ES")}` : "sin expiración"}
								${apiKey.remaining !== null ? ` · ${apiKey.remaining} restantes` : ""}
							</div>
						</div>
						<button
							data-delete-key-id="${apiKey.id}"
							data-delete-key-name="${escapeHtml(apiKey.name || "Sin nombre")}"
							class="delete-api-key-btn ml-3 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive"
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg>
						</button>
					`;
					apiKeysList.appendChild(card);
				});

				// Attach delete handlers
				apiKeysList.querySelectorAll<HTMLButtonElement>(".delete-api-key-btn").forEach((btn) => {
					btn.addEventListener("click", () => {
						const keyId = btn.dataset.deleteKeyId;
						const keyName = btn.dataset.deleteKeyName;
						if (!keyId) return;
						deleteKeyId = keyId;
						deleteKeyName = keyName || "Sin nombre";
						deleteKeyNameEl.textContent = deleteKeyName;
						deleteBackdrop?.classList.remove("hidden");
						deleteBackdrop?.setAttribute("data-state", "open");
						deleteDialog?.setAttribute("data-state", "open");
						deleteDialog?.showModal();
					});
				});
			} catch {
				apiKeysList.innerHTML =
					'<div class="text-xs text-destructive py-4 text-center">Error al cargar API keys</div>';
			}
		}

		function escapeHtml(str: string) {
			const div = document.createElement("div");
			div.textContent = str;
			return div.innerHTML;
		}
	</script>
</Layout>
