---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dashboard - Canvas App">
	<div class="min-h-screen bg-background">
		<!-- Top Bar -->
		<header class="sticky top-0 z-10 border-b border-border bg-background/80 backdrop-blur-sm">
			<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
				<div class="flex items-center gap-3">
					<div
						class="flex h-8 w-8 items-center justify-center rounded-lg bg-foreground text-background"
					>
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="3" y="3" width="18" height="18" rx="2"></rect>
							<circle cx="8.5" cy="8.5" r="1.5"></circle>
							<polyline points="21 15 16 10 5 21"></polyline>
						</svg>
					</div>
					<span class="text-lg font-semibold">Canvas</span>
				</div>
				<div class="flex items-center gap-3">
					<span id="user-name" class="text-sm text-muted-foreground"></span>
					<button
						id="btn-logout"
						class="rounded-lg border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
					>
						Cerrar sesión
					</button>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
			<!-- Header -->
			<div class="mb-8 flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold tracking-tight">Mis lienzos</h1>
					<p class="mt-1 text-sm text-muted-foreground">Gestiona y organiza todos tus lienzos</p>
				</div>
				<button
					id="btn-new-canvas"
					class="flex items-center gap-2 rounded-lg bg-foreground px-4 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
				>
					<svg
						class="h-4 w-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
					</svg>
					Nuevo lienzo
				</button>
			</div>

			<!-- Loading State -->
			<div id="loading-state" class="flex items-center justify-center py-20">
				<div class="text-sm text-muted-foreground">Cargando lienzos...</div>
			</div>

			<!-- Empty State -->
			<div id="empty-state" class="hidden py-20 text-center">
				<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-muted">
					<svg
						class="h-8 w-8 text-muted-foreground"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="3" width="18" height="18" rx="2"></rect>
						<circle cx="8.5" cy="8.5" r="1.5"></circle>
						<polyline points="21 15 16 10 5 21"></polyline>
					</svg>
				</div>
				<h3 class="text-lg font-semibold">No hay lienzos</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Crea tu primer lienzo para empezar a trabajar
				</p>
				<button
					id="btn-new-canvas-empty"
					class="mt-6 inline-flex items-center gap-2 rounded-lg bg-foreground px-4 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
				>
					<svg
						class="h-4 w-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
					</svg>
					Crear primer lienzo
				</button>
			</div>

			<!-- Canvas Grid -->
			<div
				id="canvas-grid"
				class="hidden grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
			>
			</div>
		</main>
	</div>

	<!-- Delete Confirmation Modal -->
	<div
		id="delete-modal"
		class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"
	>
		<div class="mx-4 w-full max-w-sm rounded-xl border border-border bg-background p-6 shadow-lg">
			<h3 class="text-lg font-semibold">Eliminar lienzo</h3>
			<p class="mt-2 text-sm text-muted-foreground">
				¿Estás seguro de que deseas eliminar este lienzo? Esta acción no se puede deshacer.
			</p>
			<div class="mt-6 flex justify-end gap-3">
				<button
					id="btn-cancel-delete"
					class="rounded-lg border border-border px-4 py-2 text-sm hover:bg-muted"
				>
					Cancelar
				</button>
				<button
					id="btn-confirm-delete"
					class="rounded-lg bg-destructive px-4 py-2 text-sm text-white hover:opacity-90"
				>
					Eliminar
				</button>
			</div>
		</div>
	</div>

	<script>
		interface CanvasItem {
			id: string;
			name: string;
			description: string | null;
			thumbnail: string | null;
			createdAt: string;
			updatedAt: string;
		}

		const grid = document.getElementById("canvas-grid")!;
		const loadingState = document.getElementById("loading-state")!;
		const emptyState = document.getElementById("empty-state")!;
		const deleteModal = document.getElementById("delete-modal")!;
		let deleteTargetId: string | null = null;

		// Check auth and load canvases
		async function init() {
			try {
				const sessionRes = await fetch("/api/auth/get-session", {
					credentials: "include",
				});
				if (!sessionRes.ok) {
					window.location.href = "/login";
					return;
				}
				const sessionData = await sessionRes.json();

				if (!sessionData?.user) {
					window.location.href = "/login";
					return;
				}

				document.getElementById("user-name")!.textContent =
					sessionData.user.name || sessionData.user.email;
				await loadCanvases();
			} catch {
				window.location.href = "/login";
			}
		}

		async function loadCanvases() {
			loadingState.classList.remove("hidden");
			grid.classList.add("hidden");
			emptyState.classList.add("hidden");

			try {
				const res = await fetch("/api/canvases", {
					credentials: "include",
				});
				if (!res.ok) throw new Error("Failed to load");
				const canvases: CanvasItem[] = await res.json();

				loadingState.classList.add("hidden");

				if (canvases.length === 0) {
					emptyState.classList.remove("hidden");
					return;
				}

				grid.innerHTML = "";
				canvases.forEach((c) => {
					const card = document.createElement("div");
					card.className =
						"group relative overflow-hidden rounded-xl border border-border bg-card transition-colors hover:border-ring";
					card.innerHTML = `
            <a href="/canvas/${c.id}" class="block p-4">
              <div class="aspect-video overflow-hidden rounded-lg bg-muted mb-3">
                ${
									c.thumbnail
										? `<img src="${c.thumbnail}" alt="${c.name}" class="h-full w-full object-cover" />`
										: `<div class="flex h-full items-center justify-center">
                      <svg class="h-10 w-10 text-muted-foreground/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    </div>`
								}
              </div>
              <h3 class="font-medium truncate">${escapeHtml(c.name)}</h3>
              <p class="mt-0.5 text-xs text-muted-foreground">
                ${formatDate(c.updatedAt)}
              </p>
            </a>
            <button
              data-delete-id="${c.id}"
              class="delete-btn absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-lg bg-background/80 text-muted-foreground opacity-0 backdrop-blur-sm transition-all hover:bg-destructive hover:text-white group-hover:opacity-100"
              title="Eliminar"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/>
              </svg>
            </button>
          `;
					grid.appendChild(card);
				});

				// Attach delete handlers
				grid.querySelectorAll<HTMLButtonElement>(".delete-btn").forEach((btn) => {
					btn.addEventListener("click", (e) => {
						e.preventDefault();
						e.stopPropagation();
						deleteTargetId = btn.dataset.deleteId!;
						deleteModal.classList.remove("hidden");
					});
				});

				grid.classList.remove("hidden");
			} catch {
				loadingState.innerHTML =
					'<div class="text-sm text-destructive">Error al cargar lienzos</div>';
			}
		}

		// Create canvas
		async function createCanvas() {
			const btn = document.getElementById("btn-new-canvas")! as HTMLButtonElement;
			const btnEmpty = document.getElementById("btn-new-canvas-empty")! as HTMLButtonElement;
			btn.disabled = true;
			btnEmpty.disabled = true;

			try {
				const res = await fetch("/api/canvases", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ name: "Sin título" }),
					credentials: "include",
				});
				if (!res.ok) throw new Error("Failed");
				const canvas = await res.json();
				window.location.href = `/canvas/${canvas.id}`;
			} catch {
				btn.disabled = false;
				btnEmpty.disabled = false;
			}
		}

		document.getElementById("btn-new-canvas")!.addEventListener("click", createCanvas);
		document.getElementById("btn-new-canvas-empty")!.addEventListener("click", createCanvas);

		// Delete canvas
		document.getElementById("btn-cancel-delete")!.addEventListener("click", () => {
			deleteModal.classList.add("hidden");
			deleteTargetId = null;
		});

		document.getElementById("btn-confirm-delete")!.addEventListener("click", async () => {
			if (!deleteTargetId) return;
			try {
				await fetch(`/api/canvases/${deleteTargetId}`, {
					method: "DELETE",
					credentials: "include",
				});
				deleteModal.classList.add("hidden");
				deleteTargetId = null;
				await loadCanvases();
			} catch {
				// silently fail
			}
		});

		// Logout
		document.getElementById("btn-logout")!.addEventListener("click", async () => {
			await fetch("/api/auth/sign-out", {
				method: "POST",
				credentials: "include",
			});
			window.location.href = "/";
		});

		function escapeHtml(str: string) {
			const div = document.createElement("div");
			div.textContent = str;
			return div.innerHTML;
		}

		function formatDate(dateStr: string) {
			const d = new Date(dateStr);
			return d.toLocaleDateString("es-ES", {
				day: "numeric",
				month: "short",
				year: "numeric",
			});
		}

		init();
	</script>
</Layout>
