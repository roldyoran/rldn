---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Canvas App - Tu lienzo infinito">
	<main class="relative flex min-h-screen flex-col">
		<!-- Nav -->
		<nav class="relative z-10 flex items-center justify-between px-4 py-4 sm:px-6 sm:py-5 md:px-10">
			<div class="flex items-center gap-2.5">
				<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-foreground">
					<svg
						class="h-4 w-4 text-background"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="3" width="18" height="18" rx="2"></rect>
						<circle cx="8.5" cy="8.5" r="1.5"></circle>
						<polyline points="21 15 16 10 5 21"></polyline>
					</svg>
				</div>
				<span class="text-sm font-semibold tracking-tight">Canvas</span>
			</div>
			<div class="flex items-center gap-2 sm:gap-3">
				<a
					href="/login"
					class="rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:px-4"
				>
					Iniciar sesion
				</a>
				<a
					href="/login"
					class="rounded-lg bg-foreground px-3 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90 sm:px-4"
				>
					Comenzar
				</a>
			</div>
		</nav>

		<!-- Hero -->
		<div
			class="relative z-10 flex flex-1 flex-col items-center justify-center px-4 pb-16 sm:px-6 sm:pb-24"
		>
			<!-- Grid background -->
			<div class="pointer-events-none absolute inset-0 opacity-[0.04]">
				<div
					class="h-full w-full"
					style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px;"
				>
				</div>
			</div>

			<div class="relative max-w-2xl text-center">
				<!-- Eyebrow -->
				<div
					class="mb-4 inline-flex items-center gap-2 rounded-full border border-border px-3 py-1.5 sm:mb-6 sm:px-3.5 sm:py-1.5"
				>
					<span class="h-1.5 w-1.5 rounded-full bg-foreground"></span>
					<span class="text-xs font-medium text-muted-foreground">Infinite canvas</span>
				</div>

				<h1
					class="text-3xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
					style="letter-spacing: -0.03em;"
				>
					Tu espacio para
					<br />
					pensar sin limites
				</h1>

				<p
					class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground sm:mt-6 sm:text-base"
				>
					Un lienzo infinito para imagenes, diagramas y anotaciones. Organiza tus ideas en un solo
					lugar, accesible desde cualquier dispositivo.
				</p>

				<div class="mt-8 flex flex-col items-center gap-3 sm:mt-10 sm:flex-row sm:justify-center">
					<a
						href="/login"
						class="inline-flex w-full items-center justify-center rounded-lg bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90 sm:w-auto"
					>
						Empezar ahora
					</a>
					<a
						href="/login"
						class="inline-flex w-full items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:w-auto"
					>
						Ya tengo cuenta
					</a>
				</div>

				<!-- Terminal hint -->
				<div
					class="mt-10 inline-flex items-center gap-3 rounded-xl border border-border bg-muted/50 px-4 py-3 sm:mt-16"
				>
					<div class="flex gap-1.5">
						<span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/20"></span>
						<span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/20"></span>
						<span class="h-2.5 w-2.5 rounded-full bg-muted-foreground/20"></span>
					</div>
					<code class="font-mono text-xs text-muted-foreground">canvas.app/your-workspace</code>
				</div>
			</div>
		</div>

		<!-- Footer -->
		<footer class="relative z-10 border-t border-border px-4 py-6 sm:px-6 md:px-10">
			<div
				class="flex flex-col items-center gap-3 text-xs text-muted-foreground sm:flex-row sm:justify-between"
			>
				<span>&copy; 2026 Canvas App</span>
				<div class="flex gap-4">
					<a href="#" class="transition-colors hover:text-foreground">Privacidad</a>
					<a href="#" class="transition-colors hover:text-foreground">Terminos</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>
