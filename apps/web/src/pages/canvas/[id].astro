---
import Layout from "../../layouts/Layout.astro";
import { ExcalidrawEditor } from "../../components/ExcalidrawEditor";

const { id: canvasId } = Astro.params;
---

<Layout title="Lienzo - Canvas App">
	<div
		id="app"
		class="relative h-screen w-screen overflow-hidden bg-[#1b1b1a] text-[#eae8e4]"
		style="font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; user-select: none;"
	>
		<!-- Topbar -->
		<div
			id="topbar"
			class="absolute top-0 left-0 right-0 z-30 flex h-[52px] items-center justify-between border-b border-[#373634] bg-[#232322] px-3"
		>
			<div class="flex items-center gap-1.5">
				<button
					class="icon-btn flex h-[34px] w-[34px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
					id="btnBack"
					title="Volver"
				>
					<svg
						class="h-[18px] w-[18px]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
					>
				</button>
				<input
					id="docTitle"
					value="Sin título"
					class="rounded-md border-none bg-transparent px-2 py-1.5 text-sm font-semibold text-[#eae8e4] outline-none max-w-[220px] hover:bg-[#2a2926] focus:bg-[#2a2926]"
				/>
			</div>
			<div class="flex items-center gap-1.5">
				<button
					class="icon-btn flex h-[34px] w-[34px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
					id="btnSave"
					title="Guardar (Ctrl+S)"
				>
					<svg
						class="h-[18px] w-[18px]"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
						></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline
							points="7 3 7 8 15 8"></polyline></svg
					>
				</button>
			</div>
		</div>

		<!-- Toolbar -->
		<div
			id="toolbar"
			class="absolute left-3 top-[70px] z-30 flex flex-col gap-0.5 rounded-xl border border-[#373634] bg-[#232322] p-1.5"
		>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4] active:bg-[#eae8e4] active:text-[#14141f]"
				data-tool="selection"
				title="Seleccionar (V)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"><path d="M4 4l7.07 17 2.51-7.39L21 11.07z"></path></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="hand"
				title="Mover lienzo (H)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><path
						d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8M6 14l-1.7-1.7a1.7 1.7 0 0 0-2.5 2.3l4 4.6A5 5 0 0 0 9.6 21H14a5 5 0 0 0 5-5v-4a2 2 0 0 0-4 0"
					></path></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="freedraw"
				title="Lápiz (P)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="text"
				title="Texto (T)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"
					></line><line x1="12" y1="4" x2="12" y2="20"></line></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="rectangle"
				title="Rectángulo (R)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="ellipse"
				title="Elipse (O)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"><circle cx="12" cy="12" r="9"></circle></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="line"
				title="Línea (L)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"><line x1="5" y1="19" x2="19" y2="5"></line></svg
				>
			</button>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="arrow"
				title="Flecha (A)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="9 5 19 5 19 15"
					></polyline></svg
				>
			</button>
			<div class="my-1 h-px bg-[#373634] mx-1"></div>
			<button
				class="tool-btn flex h-[38px] w-[38px] items-center justify-center rounded-lg text-[#928f89] hover:bg-[#2a2926] hover:text-[#eae8e4]"
				data-tool="frame"
				title="Marco (F)"
			>
				<svg
					class="h-[18px] w-[18px]"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18M9 3v18"
					></path></svg
				>
			</button>

			<!-- Color Pickers -->
			<div class="my-1 h-px bg-[#373634] mx-1"></div>

			<!-- Stroke Color -->
			<div class="flex flex-col items-center gap-1 py-1" title="Color de trazo">
				<label class="text-[9px] text-[#928f89] uppercase tracking-wider">Trazo</label>
				<button
					id="strokeColorBtn"
					class="h-[24px] w-[24px] cursor-pointer rounded-md border border-[#373634] p-0 hover:ring-1 hover:ring-[#928f89] transition-all"
					style="background:#ffffff"
					title="Seleccionar color de trazo"></button>
				<!-- Stroke color presets -->
				<div class="flex flex-wrap gap-0.5 justify-center max-w-[38px]">
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffffff"
						data-type="stroke"
						style="background:#ffffff"
						title="Blanco"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ff6b6b"
						data-type="stroke"
						style="background:#ff6b6b"
						title="Rojo"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffa94d"
						data-type="stroke"
						style="background:#ffa94d"
						title="Naranja"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffd43b"
						data-type="stroke"
						style="background:#ffd43b"
						title="Amarillo"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#69db7c"
						data-type="stroke"
						style="background:#69db7c"
						title="Verde"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#4dabf7"
						data-type="stroke"
						style="background:#4dabf7"
						title="Azul"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#b197fc"
						data-type="stroke"
						style="background:#b197fc"
						title="Morado"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#f783ac"
						data-type="stroke"
						style="background:#f783ac"
						title="Rosa"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#928f89"
						data-type="stroke"
						style="background:#928f89"
						title="Gris"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#1e1e1e"
						data-type="stroke"
						style="background:#1e1e1e"
						title="Negro"></button>
				</div>
			</div>

			<!-- Fill Color -->
			<div class="flex flex-col items-center gap-1 py-1" title="Color de relleno">
				<label class="text-[9px] text-[#928f89] uppercase tracking-wider">Relleno</label>
				<button
					id="bgColorBtn"
					class="h-[24px] w-[24px] cursor-pointer rounded-md border border-[#373634] p-0 hover:ring-1 hover:ring-[#928f89] transition-all"
					style="background:repeating-conic-gradient(#373634 0% 25%, #1b1b1a 0% 50%) 50% / 8px 8px"
					title="Seleccionar color de relleno"></button>
				<!-- Fill color presets -->
				<div class="flex flex-wrap gap-0.5 justify-center max-w-[38px]">
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="transparent"
						data-type="bg"
						title="Sin relleno"
					>
						<span class="block h-full w-full relative"
							><span
								class="absolute inset-0 border border-[#ff4747] rotate-45 transform origin-center"
								style="border-width:1px"></span></span
						>
					</button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffffff"
						data-type="bg"
						style="background:#ffffff"
						title="Blanco"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ff6b6b"
						data-type="bg"
						style="background:#ff6b6b"
						title="Rojo"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffa94d"
						data-type="bg"
						style="background:#ffa94d"
						title="Naranja"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#ffd43b"
						data-type="bg"
						style="background:#ffd43b"
						title="Amarillo"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#69db7c"
						data-type="bg"
						style="background:#69db7c"
						title="Verde"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#4dabf7"
						data-type="bg"
						style="background:#4dabf7"
						title="Azul"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#b197fc"
						data-type="bg"
						style="background:#b197fc"
						title="Morado"></button>
					<button
						class="color-preset h-[14px] w-[14px] rounded-sm border border-[#4a4846] hover:scale-125 transition-transform"
						data-color="#f783ac"
						data-type="bg"
						style="background:#f783ac"
						title="Rosa"></button>
				</div>
			</div>
		</div>

		<!-- Canvas -->
		<div id="canvas-wrap" class="absolute inset-0 top-[52px] bg-[#1b1b1a]">
			<ExcalidrawEditor client:only="react" canvasId={canvasId!} />
		</div>

		<!-- Save indicator -->
		<div
			id="saveIndicator"
			class="absolute top-14 right-4 z-40 hidden rounded-lg bg-[#232322] border border-[#373634] px-3 py-1.5 text-xs text-[#928f89]"
		>
			<span id="saveText">Guardando...</span>
		</div>

		<input type="file" id="fileInput" accept="image/*" multiple style="display:none" />
	</div>

	<script is:inline>
		(function () {
			const CANVAS_ID = window.location.pathname.split("/").pop();
			let isDirty = false;
			let saveTimeout = null;
			let excalidrawAPI = null;
			let isSaving = false;

			const saveIndicator = document.getElementById("saveIndicator");
			const saveText = document.getElementById("saveText");
			const docTitle = document.getElementById("docTitle");

			// Load saved canvas name
			fetch(`/api/canvases/${CANVAS_ID}`, { credentials: "include" })
				.then((r) => r.json())
				.then((data) => {
					if (data.name) docTitle.value = data.name;
				})
				.catch(() => {});

			// Poll for excalidrawAPI (React sets window.__excalidrawAPI.get())
			function getAPI() {
				if (excalidrawAPI) return excalidrawAPI;
				const w = window.__excalidrawAPI;
				if (w && typeof w.get === "function") {
					excalidrawAPI = w.get();
					if (excalidrawAPI) return excalidrawAPI;
				}
				return null;
			}

			(function waitForAPI() {
				if (getAPI()) return;
				const interval = setInterval(() => {
					if (getAPI()) {
						clearInterval(interval);
					}
				}, 100);
				setTimeout(() => clearInterval(interval), 15000);
			})();

			function markDirty() {
				isDirty = true;
				scheduleSave();
			}

			function scheduleSave() {
				if (saveTimeout) clearTimeout(saveTimeout);
				saveTimeout = setTimeout(saveCanvas, 1200);
			}

			function buildStoreData() {
				const api = getAPI();
				if (!api) throw new Error("API not ready");
				const elements = api.getSceneElements();
				const appState = api.getAppState();
				const files = api.getFiles();
				const title = document.getElementById("docTitle").value || "Sin título";
				const storeData = window.__serializeExcalidraw
					? window.__serializeExcalidraw(elements, appState, files)
					: JSON.stringify({ elements, appState, files });
				return { title, storeData };
			}

			async function saveCanvas() {
				if (isSaving) return;
				const api = getAPI();
				if (!api) {
					setTimeout(saveCanvas, 500);
					return;
				}
				if (!isDirty) return;

				isSaving = true;
				saveText.textContent = "Guardando...";
				saveIndicator.style.display = "block";

				try {
					const { title, storeData } = buildStoreData();
					const res = await fetch(`/api/canvases/${CANVAS_ID}`, {
						method: "PUT",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ name: title, storeData }),
						credentials: "include",
					});
					if (!res.ok) throw new Error(`Server ${res.status}`);
					isDirty = false;
					saveText.textContent = "Guardado";
					setTimeout(() => {
						saveIndicator.style.display = "none";
					}, 1500);
				} catch (err) {
					console.error("[Canvas] Save FAILED:", err);
					saveText.textContent = "Error al guardar";
					isDirty = true;
					setTimeout(() => {
						saveIndicator.style.display = "none";
					}, 3000);
				} finally {
					isSaving = false;
				}
			}

			// ===== TOOLBAR =====
			const toolButtons = document.querySelectorAll(".tool-btn[data-tool]");
			let currentTool = "selection";

			function setTool(tool) {
				const api = getAPI();
				if (!api) return;
				// Toggle: if clicking same tool, switch back to selection
				if (currentTool === tool && tool !== "selection") {
					tool = "selection";
				}
				currentTool = tool;
				// Lock the tool so it stays active after creating elements
				api.setActiveTool({ type: tool, locked: tool !== "selection" });
				toolButtons.forEach((b) => {
					b.style.background = b.dataset.tool === currentTool ? "#eae8e4" : "";
					b.style.color = b.dataset.tool === currentTool ? "#14141f" : "";
				});
			}
			toolButtons.forEach((btn) => btn.addEventListener("click", () => setTool(btn.dataset.tool)));

			// ===== COLOR PICKERS =====
			const strokeColorBtn = document.getElementById("strokeColorBtn");
			const bgColorBtn = document.getElementById("bgColorBtn");

			// Open professional color picker popup
			strokeColorBtn.addEventListener("click", () => {
				if (window.__showColorPicker) window.__showColorPicker("stroke");
			});
			bgColorBtn.addEventListener("click", () => {
				if (window.__showColorPicker) window.__showColorPicker("bg");
			});

			function setStrokeColor(color) {
				const api = getAPI();
				if (!api) return;
				// Set for new elements
				api.updateScene({ appState: { currentItemStrokeColor: color } });
				strokeColorBtn.style.background = color === "transparent" ? "#ffffff" : color;
				// Update selected elements (v0.18+ uses selectedElementIds)
				const appState = api.getAppState();
				const selectedIds = appState.selectedElementIds || {};
				const elements = api.getSceneElements();
				const hasSelected = elements.some((el) => selectedIds[el.id]);
				if (hasSelected) {
					api.updateScene({
						elements: elements.map((el) =>
							selectedIds[el.id]
								? { ...el, strokeColor: color, version: (el.version || 0) + 1 }
								: el,
						),
					});
				}
			}

			function setBackgroundColor(color) {
				const api = getAPI();
				if (!api) return;
				// Set for new elements
				api.updateScene({ appState: { currentItemBackgroundColor: color } });
				bgColorBtn.style.background =
					color === "transparent"
						? "repeating-conic-gradient(#373634 0% 25%, #1b1b1a 0% 50%) 50% / 8px 8px"
						: color;
				// Update selected elements (v0.18+ uses selectedElementIds)
				const appState = api.getAppState();
				const selectedIds = appState.selectedElementIds || {};
				const elements = api.getSceneElements();
				const hasSelected = elements.some((el) => selectedIds[el.id]);
				if (hasSelected) {
					api.updateScene({
						elements: elements.map((el) =>
							selectedIds[el.id]
								? { ...el, backgroundColor: color, version: (el.version || 0) + 1 }
								: el,
						),
					});
				}
			}

			// Color preset buttons
			document.querySelectorAll(".color-preset").forEach((btn) => {
				btn.addEventListener("click", () => {
					const color = btn.dataset.color;
					const type = btn.dataset.type;
					if (type === "stroke") setStrokeColor(color);
					else if (type === "bg") setBackgroundColor(color);
				});
			});

			// ===== TOPBAR =====
			document.getElementById("btnBack").onclick = () => {
				window.location.href = "/dashboard";
			};
			document.getElementById("btnSave").onclick = saveCanvas;
			document.getElementById("docTitle").addEventListener("input", markDirty);

			// ===== SAVE TRIGGERS =====
			window.addEventListener("beforeunload", () => {
				if (isDirty) {
					try {
						const { title, storeData } = buildStoreData();
						const payload = JSON.stringify({ name: title, storeData });
						if (payload.length < 64000) {
							fetch(`/api/canvases/${CANVAS_ID}`, {
								method: "PUT",
								headers: { "Content-Type": "application/json" },
								body: payload,
								credentials: "include",
								keepalive: true,
							});
						}
					} catch (e) {
						/* ignore */
					}
				}
			});

			document.addEventListener("visibilitychange", () => {
				if (document.hidden && isDirty) {
					clearTimeout(saveTimeout);
					saveCanvas();
				}
			});

			document.addEventListener("keydown", (e) => {
				if ((e.ctrlKey || e.metaKey) && e.key === "s") {
					e.preventDefault();
					saveCanvas();
				}
			});

			// React calls this on Excalidraw onChange
			window.__onExcalidrawChange = () => {
				markDirty();
			};
		})();
	</script>
</Layout>

