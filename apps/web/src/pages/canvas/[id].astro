---
import Layout from "@/layouts/Layout.astro";
import CanvasPage from "@/components/CanvasPage";

const { id: canvasId } = Astro.params;
---

<Layout title="Lienzo - Canvas App">
	<CanvasPage client:only="react" canvasId={canvasId!} />
</Layout>

<style is:global>
	/* ========================================
	   Page-specific styles for canvas page.
	   Excalidraw variable overrides live in global.css.
	   ======================================== */

	/* Hide ALL Excalidraw built-in UI - we use our own */
	#canvas-wrap .excalidraw .App-menu_top,
	#canvas-wrap .excalidraw .App-menu__left,
	#canvas-wrap .excalidraw .App-menu__right,
	#canvas-wrap .excalidraw .ToolIcon,
	#canvas-wrap .excalidraw .SelectedShapeActions,
	#canvas-wrap .excalidraw .ColorPicker,
	#canvas-wrap .excalidraw .ActionManager,
	#canvas-wrap .excalidraw .HintViewer,
	#canvas-wrap .excalidraw .welcome-screen,
	#canvas-wrap .excalidraw .App-bottom-bar,
	#canvas-wrap .excalidraw .App-mobile-menu {
		display: none !important;
	}

	/* Ensure Excalidraw's canvas is below our UI */
	#canvas-wrap .excalidraw .layer-ui__wrapper {
		z-index: 5 !important;
	}

	/* Toolbar scrollable if too tall */
	#toolbar {
		max-height: calc(100vh - 100px);
		overflow-y: auto;
		overflow-x: hidden;
	}
	#toolbar::-webkit-scrollbar {
		width: 3px;
	}
	#toolbar::-webkit-scrollbar-thumb {
		background: #373634;
		border-radius: 3px;
	}

	/* Save indicator spinner */
	@keyframes save-spin {
		to {
			transform: rotate(360deg);
		}
	}
	.save-spinner {
		animation: save-spin 0.6s linear infinite;
	}
</style>
