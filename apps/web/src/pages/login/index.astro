---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardContent } from "@/components/starwind/card";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Spinner } from "@/components/starwind/spinner";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/starwind/tabs";
import { Alert, AlertDescription } from "@/components/starwind/alert";
---

<Layout title="Iniciar Sesión - Canvas App">
	<main class="flex min-h-screen items-center justify-center bg-background px-4">
		<div class="w-full max-w-md space-y-8">
			<!-- Logo / Brand -->
			<div class="text-center">
				<div
					class="mx-auto mb-4 flex size-16 items-center justify-center rounded-2xl bg-foreground text-background"
				>
					<svg
						class="size-8"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="3" width="18" height="18" rx="2"></rect>
						<circle cx="8.5" cy="8.5" r="1.5"></circle>
						<polyline points="21 15 16 10 5 21"></polyline>
					</svg>
				</div>
				<h1 class="text-2xl font-bold tracking-tight">Canvas App</h1>
				<p class="mt-1 text-sm text-muted-foreground">
					Tu lienzo infinito para imágenes y diagramas
				</p>
			</div>

			<!-- Auth Card -->
			<Card>
				<CardContent class="pt-6">
					<Tabs defaultValue="login" class="w-full">
						<TabsList class="mb-6 w-full">
							<TabsTrigger value="login" class="flex-1">Iniciar sesión</TabsTrigger>
							<TabsTrigger value="register" class="flex-1">Registrarse</TabsTrigger>
						</TabsList>

						<!-- Login Form -->
						<TabsContent value="login">
							<form id="login-form" class="space-y-4">
								<div class="grid gap-2">
									<Label for="login-email">Email</Label>
									<Input
										id="login-email"
										type="email"
										name="email"
										required
										placeholder="tu@email.com"
										autocomplete="email"
									/>
								</div>
								<div class="grid gap-2">
									<Label for="login-password">Contraseña</Label>
									<Input
										id="login-password"
										type="password"
										name="password"
										required
										placeholder="••••••••"
										autocomplete="current-password"
									/>
								</div>
								<Alert id="login-error" variant="error" class="hidden">
									<AlertDescription></AlertDescription>
								</Alert>
								<Button type="submit" id="login-btn" class="w-full" size="lg">
									<Spinner id="login-spinner" class="hidden" />
									<span id="login-btn-text">Iniciar sesión</span>
								</Button>
							</form>
						</TabsContent>

						<!-- Register Form -->
						<TabsContent value="register">
							<form id="register-form" class="space-y-4">
								<div class="grid gap-2">
									<Label for="register-name">Nombre</Label>
									<Input
										id="register-name"
										type="text"
										name="name"
										required
										placeholder="Tu nombre"
										autocomplete="name"
									/>
								</div>
								<div class="grid gap-2">
									<Label for="register-email">Email</Label>
									<Input
										id="register-email"
										type="email"
										name="email"
										required
										placeholder="tu@email.com"
										autocomplete="email"
									/>
								</div>
								<div class="grid gap-2">
									<Label for="register-password">Contraseña</Label>
									<Input
										id="register-password"
										type="password"
										name="password"
										required
										minlength={6}
										placeholder="Mínimo 6 caracteres"
										autocomplete="new-password"
									/>
								</div>
								<Alert id="register-error" variant="error" class="hidden">
									<AlertDescription></AlertDescription>
								</Alert>
								<Button type="submit" id="register-btn" class="w-full" size="lg">
									<Spinner id="register-spinner" class="hidden" />
									<span id="register-btn-text">Crear cuenta</span>
								</Button>
							</form>
						</TabsContent>
					</Tabs>
				</CardContent>
			</Card>

			<!-- Back to home -->
			<p class="text-center text-sm text-muted-foreground">
				<a href="/" class="underline underline-offset-4 transition-colors hover:text-foreground"
					>← Volver al inicio</a
				>
			</p>
		</div>
	</main>

	<script>
		const loginForm = document.getElementById("login-form") as HTMLFormElement;
		const registerForm = document.getElementById("register-form") as HTMLFormElement;
		const loginError = document.getElementById("login-error")!;
		const registerError = document.getElementById("register-error")!;
		const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
		const registerBtn = document.getElementById("register-btn") as HTMLButtonElement;
		const loginSpinner = document.getElementById("login-spinner")!;
		const registerSpinner = document.getElementById("register-spinner")!;
		const loginBtnText = document.getElementById("login-btn-text")!;
		const registerBtnText = document.getElementById("register-btn-text")!;

		function setLoading(
			btn: HTMLButtonElement,
			spinner: HTMLElement,
			textEl: HTMLElement,
			loading: boolean,
		) {
			btn.disabled = loading;
			btn.setAttribute("aria-busy", loading.toString());
			spinner.classList.toggle("hidden", !loading);
			textEl.textContent = loading
				? btn.id === "login-btn"
					? "Iniciando sesión..."
					: "Creando cuenta..."
				: btn.id === "login-btn"
					? "Iniciar sesión"
					: "Crear cuenta";
		}

		function showError(el: HTMLElement, msg: string) {
			const desc = el.querySelector("[data-slot='alert-description']") || el.querySelector("p");
			if (desc) desc.textContent = msg;
			el.classList.remove("hidden");
		}

		// Login
		loginForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			loginError.classList.add("hidden");
			const email = (document.getElementById("login-email") as HTMLInputElement).value;
			const password = (document.getElementById("login-password") as HTMLInputElement).value;

			setLoading(loginBtn, loginSpinner, loginBtnText, true);
			try {
				const res = await fetch("/api/auth/sign-in/email", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, password }),
					credentials: "include",
				});
				if (!res.ok) {
					let msg = "Error al iniciar sesión";
					try {
						const data = await res.json();
						msg = data.error?.message || data.message || msg;
					} catch {}
					showError(loginError, msg);
					return;
				}
				const data = await res.json();
				if (data.error) {
					showError(loginError, data.error.message || "Error al iniciar sesión");
					return;
				}
				window.location.href = "/dashboard";
			} catch {
				showError(loginError, "Error de conexión");
			} finally {
				setLoading(loginBtn, loginSpinner, loginBtnText, false);
			}
		});

		// Register
		registerForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			registerError.classList.add("hidden");
			const name = (document.getElementById("register-name") as HTMLInputElement).value;
			const email = (document.getElementById("register-email") as HTMLInputElement).value;
			const password = (document.getElementById("register-password") as HTMLInputElement).value;

			setLoading(registerBtn, registerSpinner, registerBtnText, true);
			try {
				const res = await fetch("/api/auth/sign-up/email", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ name, email, password }),
					credentials: "include",
				});
				if (!res.ok) {
					let msg = "Error al registrar";
					try {
						const data = await res.json();
						msg = data.error?.message || data.message || msg;
					} catch {}
					showError(registerError, msg);
					return;
				}
				const data = await res.json();
				if (data.error) {
					showError(registerError, data.error.message || "Error al registrar");
					return;
				}
				window.location.href = "/dashboard";
			} catch {
				showError(registerError, "Error de conexión");
			} finally {
				setLoading(registerBtn, registerSpinner, registerBtnText, false);
			}
		});
	</script>
</Layout>
