{
  "name": "rldn",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "build": "turbo build",
    "build:web": "turbo build --filter=@repo/web",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@repo/web",
    "typecheck": "turbo typecheck",
    "typecheck:web": "turbo typecheck --filter=@repo/web",
    "format": "biome check --write .",
    "routes": "bun run --filter=@repo/web generate-routes",
    "db:generate": "bun run --filter=@repo/db db:generate",
    "db:push": "bun run --filter=@repo/db db:push",
    "db:studio": "bun run --filter=@repo/db db:studio",
    "db:migrate": "bun run --filter=@repo/db db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "turbo": "^2.5.0",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "better-sqlite3"
    ]
  }
}
