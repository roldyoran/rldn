{
	"name": "rldn",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter=@repo/web",
		"build": "turbo build",
		"build:web": "turbo build --filter=@repo/web",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "turbo typecheck",
		"typecheck:web": "turbo typecheck --filter=@repo/web",
		"db:generate": "bun run --filter=@repo/db db:generate",
		"db:push": "bun run --filter=@repo/db db:push",
		"db:studio": "bun run --filter=@repo/db db:studio",
		"db:migrate": "bun run --filter=@repo/db db:migrate",
		"dev:extension": "bun run --filter=@repo/extension dev",
		"build:extension": "bun run --filter=@repo/extension build"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@typescript-eslint/parser": "^8.65.0",
		"astro-eslint-parser": "^3.0.0",
		"eslint": "^9.28.0",
		"eslint-plugin-astro": "^1.3.1",
		"globals": "^16.2.0",
		"prettier": "^3.5.3",
		"prettier-plugin-astro": "^0.14.1",
		"turbo": "^2.5.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.33.0"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.25",
		"@better-auth/drizzle-adapter": "^1.6.25",
		"better-auth": "^1.6.25"
	}
}
